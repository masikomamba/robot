<?xml version='1.0'?>
<!--
  room_hall.sdf: World for CS 4023/5023 Project 1.
  A 15 ft x 10 ft room with a 5 ft doorway centered on its south (long) wall,
  wrapped on its south and east sides by a 5 ft wide backwards-L hallway.
  Long hall branch (south) is about 20 ft, short branch (east) about 15 ft.
  The hall is closed at both ends and has a 5 ft exterior doorway in its
  south wall, 5 ft from the west end of the long branch.
  Units are meters. Room interior spans x = 0 to 4.572, y = 0 to 3.048.
  Walls are 0.1 m thick and 0.6 m tall. Generated by tools/gen_world.py.
-->
<sdf version='1.8'>
  <world name='room_hall'>
    <physics name='3ms' type='ignored'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Same system plugins the stock TurtleBot 4 worlds load. -->
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster'
            filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>

    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='room_north_wall'>
      <static>true</static>
      <pose>3.0980 3.0980 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>6.3960 0.1000 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>6.3960 0.1000 0.6</size></box></geometry>
          <material><ambient>0.80 0.65 0.45 1</ambient><diffuse>0.80 0.65 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='room_west_wall'>
      <static>true</static>
      <pose>-0.0500 0.6620 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.1000 4.7720 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.1000 4.7720 0.6</size></box></geometry>
          <material><ambient>0.80 0.65 0.45 1</ambient><diffuse>0.80 0.65 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='room_south_wall_left'>
      <static>true</static>
      <pose>0.7620 -0.0500 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>1.5240 0.1000 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>1.5240 0.1000 0.6</size></box></geometry>
          <material><ambient>0.80 0.65 0.45 1</ambient><diffuse>0.80 0.65 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='room_south_wall_right'>
      <static>true</static>
      <pose>3.8600 -0.0500 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>1.6240 0.1000 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>1.6240 0.1000 0.6</size></box></geometry>
          <material><ambient>0.80 0.65 0.45 1</ambient><diffuse>0.80 0.65 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='room_east_wall'>
      <static>true</static>
      <pose>4.6220 1.4740 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.1000 3.1480 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.1000 3.1480 0.6</size></box></geometry>
          <material><ambient>0.80 0.65 0.45 1</ambient><diffuse>0.80 0.65 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='hall_south_wall_left'>
      <static>true</static>
      <pose>0.7120 -1.6740 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>1.6240 0.1000 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>1.6240 0.1000 0.6</size></box></geometry>
          <material><ambient>0.45 0.60 0.80 1</ambient><diffuse>0.45 0.60 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='hall_south_wall_right'>
      <static>true</static>
      <pose>4.6720 -1.6740 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>3.2480 0.1000 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>3.2480 0.1000 0.6</size></box></geometry>
          <material><ambient>0.45 0.60 0.80 1</ambient><diffuse>0.45 0.60 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='hall_east_wall'>
      <static>true</static>
      <pose>6.2460 0.7120 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.1000 4.8720 0.6</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.1000 4.8720 0.6</size></box></geometry>
          <material><ambient>0.45 0.60 0.80 1</ambient><diffuse>0.45 0.60 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
